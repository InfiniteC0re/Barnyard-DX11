<?xml version="1.0"?>
<!--
    Per-level static point lights.

    Each <level> is keyed by the game's terrain/level name (see the Terrain_ enum).
    Each <light> is a fixed world-space point light:
      - x/y/z:     world position
      - radius:    influence radius (world units)
      - r/g/b:     colour (0..1)
      - intensity: brightness multiplier
      - enabled:   on/off
      - nightOnly: only lit at night

    Authored in-game via Light Manager -> Static tab. "Save" writes the current
    level (preserving other levels); the level's lights auto-load on entering it.
    Saved to Game\Data\StaticLights.xml -- copy it back here to track in the repo.

    Example:
    <level name="EnvMain">
        <light x="10.0" y="2.5" z="-8.0" radius="12" r="1.0" g="0.85" b="0.6" intensity="2.0" enabled="true" nightOnly="false"/>
    </level>
-->
